# Python y herramientas locales
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Configuración local y secretos de Streamlit
.streamlit/secrets.toml
.streamlit/credentials.toml

# Estado local del servidor Lumbre
/.lumbre/
# Mantener ignorados los nombres usados por versiones anteriores.
.lumbre-instance.json
.lumbre-instance.lock
.lumbre-instance.*.tmp

# Frontend React/Vite
frontend/node_modules/
frontend/.vite/
.venv/

# Salidas temporales de pruebas e inspección manual
/.tmp/

# Resultados locales de evaluación; se conserva versionado el informe histórico de agua.
/resultados/clasificacion/contextual/
/resultados/experimentos/historico/
# Ignorar nuevas salidas de agua y mantener visibles los artefactos históricos existentes.
/resultados/clasificacion/agua/*
!/resultados/clasificacion/agua/90dd412/
!/resultados/clasificacion/agua/90dd412/**

# Datos y modelos locales del clasificador supervisado
/training/random_forest/dataset/
/training/random_forest/random_forest.joblib
